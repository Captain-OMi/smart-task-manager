# This file is used as a safe sample environment configuration for the Smart Task Manager project, showing which secret keys and PostgreSQL database settings must be copied into a real .env file before running the Flask app.
FLASK_SECRET_KEY=change_this_to_a_long_random_secret_key
FLASK_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_NAME=smart_task_manager
DB_USER=postgres
DB_PASSWORD=your_postgresql_password
